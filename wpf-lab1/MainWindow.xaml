<Window x:Class="wpf_lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_lab1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock HorizontalAlignment="Center" Margin="407,108,0,0" TextWrapping="Wrap" Text="Select a message option
and then choose the Display button." VerticalAlignment="Top"/>
        <RadioButton x:Name="HelloButton" Content="Hello" IsChecked="True" HorizontalAlignment="Left" Margin="255,0,0,0" VerticalAlignment="Center"/> 
        <RadioButton x:Name="GoodbyeButton" Content="Goodbye" HorizontalAlignment="Left" Margin="481,0,0,0" VerticalAlignment="Center"/>
        <Button Content="Display" HorizontalAlignment="Center" Margin="0,302,0,0" VerticalAlignment="Top" Click="Button_Click" Height="25" Width="85"/>
    </Grid>
</Window>
